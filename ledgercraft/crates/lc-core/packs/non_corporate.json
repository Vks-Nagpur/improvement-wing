      "label": "(c) Long-term provisions"
    },
    {
      "t": "s",
      "label": "(3) Current liabilities"
    },
    {
      "t": "i",
      "head": "ST_BORROWINGS",
      "label": "(a) Short-term borrowings"
    },
    {
      "t": "i",
      "head": "TRADE_PAYABLES",
      "label": "(b) Trade payables"
    },
    {
      "t": "i",
      "head": "OTHER_CURRENT_LIABILITIES",
      "label": "(c) Other current liabilities"
    },
    {
      "t": "i",
      "head": "ST_PROVISIONS",
      "label": "(d) Short-term provisions"
    },
    {
      "t": "total",
      "side": "liab",
      "label": "TOTAL"
    },
    {
      "t": "h",
      "label": "II. ASSETS"
    },
    {
      "t": "s",
      "label": "(1) Non-current assets"
    },
    {
      "t": "s2",
      "label": "(a) Property, Plant and Equipment and Intangible assets"
