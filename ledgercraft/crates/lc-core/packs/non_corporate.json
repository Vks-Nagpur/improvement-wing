      "label": "(d) Cash and bank balances"
    },
    {
      "t": "i",
      "head": "ST_LOANS_ADVANCES",
      "label": "(e) Short-term loans and advances"
    },
    {
      "t": "i",
      "head": "OTHER_CURRENT_ASSETS",
