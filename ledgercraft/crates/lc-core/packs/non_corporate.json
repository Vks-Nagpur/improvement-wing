      "label": "Changes in inventories of finished goods, work-in-progress and Stock-in-Trade"
    },
    {
      "t": "i",
      "head": "EMPLOYEE_BENEFITS",
      "label": "Employee benefits expense"
    },
    {
      "t": "i",
      "head": "FINANCE_COSTS",
      "label": "Finance costs"
    },
    {
      "t": "i",
      "head": "DEPRECIATION",
      "label": "Depreciation and amortisation expense"
    },
    {
      "t": "i",
      "head": "OTHER_EXPENSES",
      "label": "Other expenses"
    },
    {
      "t": "sum",
      "heads": [
        "PURCHASES",
        "CHANGE_IN_INVENTORIES",
        "EMPLOYEE_BENEFITS",
        "FINANCE_COSTS",
        "DEPRECIATION",
        "OTHER_EXPENSES"
      ],
      "label": "Total expenses"
    },
    {
      "t": "calc",
      "calc": "pbr",
      "label": "V. Profit before {remuneration_label} and tax (III - IV)"
    },
    {
      "t": "i",
      "head": "PARTNERS_REMUNERATION",
      "label": "VI. {remuneration_label}",
      "keep": true
    },
    {
      "t": "calc",
      "calc": "pbt",
      "label": "VII. Profit before tax (V - VI)"
    },
    {
      "t": "i",
      "head": "TAX_EXPENSE",
      "label": "VIII. Tax expense",
      "keep": true
    },
    {
      "t": "calc",
      "calc": "profit",
      "label": "IX. Profit / (Loss) for the year (VII - VIII)"
    }
  ]
